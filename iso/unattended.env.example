# Example unattended installer configuration.
# Place this file at /unattended.env on a second disk/volume labeled 'cidata',
# or pass it manually via: omarchy-custom-install --config /path/to/unattended.env

TARGET_DISK="/dev/vda"
LUKS_PASSWORD="changeme"
USERNAME="keilan"
USER_PASSWORD="changeme"
FULL_NAME="Keilan"
EMAIL_ADDRESS="keilan@example.com"
HOSTNAME="omarchy"
TIMEZONE="Europe/London"
KEYBOARD="uk"
LOCALE="en_GB.UTF-8"
LANGUAGE="en"
OVERLAY_PROFILE="desktop"
AUTO_REBOOT="0"
